# OpenCart 3.0.5.1
#
# Copy this file to .env for a new sandbox started with docker-compose.yml.
# An existing shop does not need these variables. Its config.php is used as-is.
# Change only the image tag on that stack, and keep the /var/www volume,
# the mysql service name, Traefik, and PHP_MEMORY_LIMIT.

# mysql:8.0 still accepts mysql_native_password.
# percona:8 is a supported override for an existing Percona server.
MYSQL_IMAGE=mysql:8.0
OPENCART_IMAGE=ghcr.io/aam-git/docker-opencart:3.0.5.1

HTTP_PORT=80
MYSQL_PORT=3306

# Database hostname is the compose service name, which is mysql.
DB_HOSTNAME=mysql
DB_PORT=3306
DB_DATABASE=opencart
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here
DB_DRIVER=mysqli
DB_PREFIX=oc_

# Used only when the database has no OpenCart tables yet.
OPENCART_USERNAME=admin
OPENCART_PASSWORD=your_secure_admin_password_here
OPENCART_EMAIL=admin@yourdomain.com
# Optional. Leave these unset to keep the installer defaults.
# OPENCART_FIRSTNAME=Admin
# OPENCART_LASTNAME=User
# OPENCART_SITE_NAME=My OpenCart Store
OPENCART_SITE_URL=http://localhost

# Applied on every start. 2G is a valid value.
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
TZ=UTC
