# =============================================================================
# OpenCart Docker Environment Configuration
# =============================================================================
# 
# This file contains all configurable environment variables for the OpenCart
# Docker container setup. Copy this file to `.env` and customize the values
# for your specific deployment.
#
# SECURITY WARNING: 
# - Never commit your actual .env file to version control!
# - The .env file should be added to your .gitignore
# - Use strong, unique passwords for production deployments
# 
# Version: 4.1.0.3
# Documentation: https://github.com/aam-git/docker-opencart
# =============================================================================

# ==============================================
# DOCKER IMAGE VERSIONS
# ==============================================
MYSQL_VERSION=9
OPENCART_IMAGE=ghcr.io/aam-git/docker-opencart:testing

# ==============================================
# PORT CONFIGURATION
# ==============================================
# HTTP port for OpenCart (default: 80)
HTTP_PORT=80

# HTTPS port for OpenCart (default: 443)
HTTPS_PORT=443

# MySQL port (default: 3306) - only needed if accessing MySQL externally
MYSQL_PORT=3306

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Database name - used for both MySQL database creation and OpenCart connection
DB_DATABASE=opencart

# Database password - CHANGE THIS! 
# This will be used for both MySQL root password and OpenCart database connection
# Must be at least 8 characters and not a common/default password
DB_PASSWORD=your_secure_mysql_password_here

# Database hostname (use 'database' for docker-compose setup)
DB_HOSTNAME=database

# Database port
DB_PORT=3306

# Database username
DB_USERNAME=root

# Database driver (mysqli, pdo, pgsql - mysqli recommended for MySQL)
DB_DRIVER=mysqli

# Database table prefix (default: oc_ - change for multiple installations)
DB_PREFIX=oc_

# ==============================================
# OPENCART ADMIN ACCOUNT
# ==============================================
# Admin username for OpenCart dashboard
OPENCART_USERNAME=admin

# Admin password - CHANGE THIS TO SOMETHING SECURE!
OPENCART_PASSWORD=your_secure_admin_password_here

# Admin email address
OPENCART_EMAIL=admin@yourdomain.com

# ==============================================
# SITE CONFIGURATION
# ==============================================
# Your store name
OPENCART_SITE_NAME=My Awesome Store

# Your site URL (include http:// or https://)
# For local development: http://localhost
# For production: https://yourdomain.com
OPENCART_SITE_URL=http://localhost

# ==============================================
# OPENCART ADVANCED CONFIGURATION
# ==============================================
# Installation language (en-gb, fr-fr, etc. - only for v4+)
# For v3.x this is ignored as language selection happens post-install
OPENCART_LANGUAGE=en-gb

# Admin user details - First and Last name
OPENCART_FIRSTNAME=Admin
OPENCART_LASTNAME=User

# PHP Settings
# Maximum execution time for installation (seconds)
PHP_MAX_EXECUTION_TIME=300

# PHP memory limit for installation
PHP_MEMORY_LIMIT=256M

# =============================================================================
# ADVANCED CONFIGURATION OPTIONS
# =============================================================================
#
# MULTI-STORE CONFIGURATION:
# For multiple OpenCart instances, change DB_PREFIX to avoid table conflicts
# Example: DB_PREFIX=store1_, DB_PREFIX=store2_, etc.
#
# LANGUAGE SUPPORT:
# Available languages depend on OpenCart version:
# ├── v4.x: en-gb, fr-fr, de-de, es-es, it-it, ru-ru, etc.
# ├── v3.x: Language selection happens post-installation
# └── Check /install/ directory for available language SQL files
#
# DATABASE DRIVERS:
# ├── mysqli: Recommended for MySQL/MariaDB (default)
# ├── pdo: Alternative MySQL driver
# └── pgsql: For PostgreSQL (requires additional setup)
#
# PHP TUNING:
# ├── PHP_MAX_EXECUTION_TIME: Increase for large installations
# ├── PHP_MEMORY_LIMIT: Increase for complex themes/extensions
# └── Values are applied during installation only
#
# =============================================================================
# SECURITY REQUIREMENTS AND BEST PRACTICES
# =============================================================================
# 
# MANDATORY CHANGES:
# ├── DB_PASSWORD: Change from default - container will refuse to start otherwise
# ├── OPENCART_PASSWORD: Change from default - container will refuse to start otherwise  
# └── OPENCART_EMAIL: Set to your actual email address
#
# PASSWORD REQUIREMENTS:
# ├── Minimum 8 characters in length
# ├── Cannot be common passwords (password, 123456, admin, etc.)
# └── Cannot be default placeholder values
#
# PRODUCTION SECURITY CHECKLIST:
# ├── ✓ Use HTTPS with proper SSL certificates
# ├── ✓ Set strong, unique passwords (consider password managers)
# ├── ✓ Use Docker secrets for sensitive data in production
# ├── ✓ Regularly update passwords and Docker images
# ├── ✓ Implement regular backup procedures
# ├── ✓ Monitor container logs for security issues
# ├── ✓ Use non-standard ports if required by security policy
# └── ✓ Use unique DB_PREFIX for multiple installations
#
# BLOCKED INSECURE VALUES:
# The container will refuse to start with these insecure passwords:
# please_change_this_password, secure_password_here, admin123, password,
# 123456, admin, root, opencart, or any password shorter than 8 characters
# =============================================================================