  <file path="system/library/cache/file.php">
    <operation error="skip">
      <ignoreif><![CDATA[$handle = @fopen($files[0], 'r');]]></ignoreif>
      <search regex="true"><![CDATA[/if \(\$files\) \{\s*\$handle = fopen\(\$files\[0\], 'r'\);\s*flock\(\$handle, LOCK_SH\);\s*\$data = fread\(\$handle, filesize\(\$files\[0\]\)\);\s*flock\(\$handle, LOCK_UN\);\s*fclose\(\$handle\);\s*return json_decode\(\$data, true\);\s*\}/]]></search>
      <add><![CDATA[if ($files && is_file($files[0])) {
			$handle = @fopen($files[0], 'r');

			if ($handle) {
				flock($handle, LOCK_SH);

				$size = @filesize($files[0]);

				if ($size) {
					$data = fread($handle, $size);

					flock($handle, LOCK_UN);

					fclose($handle);

					return json_decode($data, true);
				}

				flock($handle, LOCK_UN);

				fclose($handle);
			}
		}]]></add>
    </operation>
  </file>

